# Required for actual recommendations
YOUTUBE_API_KEY=

# Optional: when unset, an in-memory cache is used for local development.
REDIS_URL=
RECOMMENDATION_CACHE_TTL_SECONDS=1800
YOUTUBE_CANDIDATE_LIMIT=20
# search.list(100)와 videos.list(1) 호출을 앱에서 누적해 계산하는 기준값입니다.
YOUTUBE_DAILY_QUOTA_LIMIT=10000

# Streamlit Google OIDC와 같은 OAuth Client ID입니다. 서버에서 ID 토큰 검증에 사용합니다.
GOOGLE_OAUTH_CLIENT_ID=

# Optional: enable recommendation-history storage in Supabase.
SUPABASE_URL=
# Settings → API Keys → Secret keys의 sb_secret_... 값을 사용합니다.
SUPABASE_SECRET_KEY=
# 기존 프로젝트에서만 사용: SUPABASE_SERVICE_ROLE_KEY=

APP_NAME=YouPick API
APP_ENV=development
# 쉼표로 구분합니다. Streamlit 기본 주소를 허용합니다.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
